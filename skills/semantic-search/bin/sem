#!/usr/bin/env bash
# sem — wrapper for the semantic-search skill.
#
# Sets up an environment in which every write (indexes, caches, temp files)
# lands in ./.sem of the current directory and nothing touches the network,
# then runs the sem Python package with the runtime's own interpreter.
set -euo pipefail

# --- resolve this script's real location (portable; no readlink -f needed) ---
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  dir="$(cd -P "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  case "$src" in /*) ;; *) src="$dir/$src" ;; esac
done
SKILL_DIR="$(cd -P "$(dirname "$src")/.." && pwd)"

# --- locate the runtime -------------------------------------------------------
runtime=""
for cand in \
    "${SEM_RUNTIME:-}" \
    "$SKILL_DIR/runtime" \
    "$( [ -f "$SKILL_DIR/.runtime-path" ] && cat "$SKILL_DIR/.runtime-path" || true)" \
    "${XDG_DATA_HOME:-$HOME/.local/share}/semantic-search/runtime"; do
  if [ -n "$cand" ] && [ -f "$cand/install.json" ]; then runtime="$cand"; break; fi
done
if [ -z "$runtime" ]; then
  echo "sem: runtime not found. Run ./setup.sh from the semantic-search repo in your own terminal." >&2
  exit 3
fi
PY="$runtime/python/bin/python3"
if [ ! -x "$PY" ]; then
  echo "sem: runtime at $runtime is incomplete (no python). Re-run ./setup.sh." >&2
  exit 3
fi

# --- project-local state --------------------------------------------------------
SEM_HOME="${SEM_HOME:-$PWD/.sem}"
if ! mkdir -p "$SEM_HOME/tmp" "$SEM_HOME/cache" "$SEM_HOME/indexes" 2>/dev/null; then
  echo "sem: cannot create $SEM_HOME." >&2
  echo "sem stores its indexes in the project directory (./.sem). cd into a project directory you can write to and retry." >&2
  exit 3
fi
[ -f "$SEM_HOME/.gitignore" ] || printf '*\n' > "$SEM_HOME/.gitignore"

export SEM_HOME SEM_RUNTIME="$runtime"
export TMPDIR="$SEM_HOME/tmp"
export XDG_CACHE_HOME="$SEM_HOME/cache"
export PYTHONDONTWRITEBYTECODE=1 PYTHONNOUSERSITE=1
export TOKENIZERS_PARALLELISM=false
export PYTHONPATH="$SKILL_DIR${PYTHONPATH:+:$PYTHONPATH}"

# -P: don't put the cwd on sys.path (a project's own "sem" package must not shadow ours)
exec "$PY" -P -s -m sem "$@"
